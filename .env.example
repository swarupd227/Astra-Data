# Copy to .env for local development. Never commit .env.
# Secrets in a deployed tenant come from Azure Key Vault, never from a file (spec §18.1).

ASTRA_POSTGRES_HOST=localhost
ASTRA_POSTGRES_PORT=5432
ASTRA_POSTGRES_DB=astra
ASTRA_POSTGRES_USER=astra
ASTRA_POSTGRES_PASSWORD=astra_local_dev_only

# Name of the Apache AGE graph holding the Estate Graph for this tenant.
ASTRA_GRAPH_NAME=astra_estate

# Service
ASTRA_LOG_LEVEL=INFO
ASTRA_ENV=local

# Credentials for the fixture adapter, which the local stack enables because ASTRA_ENV is
# local. The fixture estate is generated and accepts any token; a real adapter's credential
# comes from Key Vault (spec §18.1) and never from here.
ASTRA_CREDENTIAL_TABLEAU_RQA=fixture-local-only
ASTRA_CREDENTIAL_TABLEAU_GTAA=fixture-local-only
