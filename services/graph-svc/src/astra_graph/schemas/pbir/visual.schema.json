{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astra-data.example/schemas/pbir/visual.schema.json",
  "title": "Astra Data disclosed-subset PBIR visual schema",
  "description": "See pbir.py's own module docstring: a disclosed subset, not Microsoft's own published PBIR schema. Covers the pages/<page>/visuals/<visual>/visual.json shape this Compositor emits (stories S6.1.1 and S6.1.3). A placeholder visual (redesignFlag true) still validates -- AC #3's 'the report still generates' -- with fieldWells/sort/filters/interactivity carried for whoever reviews the redesign (S6.2.1).",
  "type": "object",
  "required": [
    "$schema", "name", "visualType", "position", "fieldWells", "sort", "filters",
    "redesignFlag", "redesignReason", "sourceSheetRef", "interactivity"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "visualType": {
      "type": "string",
      "minLength": 1,
      "description": "One of the whitelisted target visual types (see pbir.VISUAL_TYPE_WHITELIST), or the literal 'placeholder' when redesignFlag is true."
    },
    "position": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      ]
    },
    "fieldWells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shelf", "role", "sourceKind", "sourceId", "sourceName", "bound", "table",
          "column", "measureId", "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "shelf": { "type": "string" },
          "role": { "type": "string" },
          "sourceKind": { "type": "string", "enum": ["Field", "CalculatedField"] },
          "sourceId": { "type": ["string", "null"] },
          "sourceName": { "type": "string" },
          "bound": { "type": "boolean" },
          "table": { "type": ["string", "null"] },
          "column": { "type": ["string", "null"] },
          "measureId": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "sort": { "type": "array" },
    "filters": { "type": "array" },
    "redesignFlag": { "type": "boolean" },
    "redesignReason": { "type": ["string", "null"] },
    "sourceSheetRef": { "type": ["string", "null"] },
    "interactivity": {
      "type": "object",
      "required": ["parameters", "actions"],
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "datatype", "domain", "kind", "supported", "values", "default", "reason"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "datatype": { "type": "string" },
              "domain": { "type": "string", "enum": ["list", "range", "any"] },
              "kind": { "type": ["string", "null"], "enum": ["what_if", "slicer", null] },
              "supported": { "type": "boolean" },
              "values": { "type": "array", "items": { "type": "string" } },
              "default": {},
              "reason": { "type": ["string", "null"] }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "role", "otherSheets", "powerBiSetting", "supported", "reason"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["filter", "highlight", "url", "parameter", "set"] },
              "role": { "type": "string", "enum": ["source", "target"] },
              "otherSheets": { "type": "array", "items": { "type": "string" } },
              "powerBiSetting": { "type": ["string", "null"], "enum": ["crossFilter", "highlight", "url", null] },
              "supported": { "type": "boolean" },
              "reason": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
